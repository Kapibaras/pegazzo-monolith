{
  "name": "credit_contract",
  "label_es": "Cotización / contrato de crédito automotriz",
  "allowed_entity_types": ["car"],
  "has_expiry": true,
  "ai_analyzable": true,
  "fields": {
    "financier": "financial institution name",
    "quote_date": "date the quote was calculated",
    "customer_name": "customer name",
    "vehicle_version": "vehicle version",
    "vehicle_year": "vehicle year",
    "vehicle_price": "vehicle price",
    "down_payment": "down payment amount",
    "down_payment_percent": "down payment percentage",
    "amount_financed": "amount to finance",
    "loan_term_months": "credit term in months",
    "monthly_payment": "monthly payment",
    "monthly_payment_from_month_13": "monthly payment from month 13",
    "annual_rate": "annual interest rate",
    "cat_average": "average CAT percentage",
    "opening_fee": "opening fee amount",
    "first_receipt_amount": "first receipt amount",
    "free_insurance_months": "months of free insurance",
    "insurer": "insurer name",
    "insurance_total_amount": "total insurance amount",
    "insurance_term_months": "insurance term in months",
    "state": "state",
    "municipality": "municipality",
    "offer_name": "offer name"
  },
  "expected_fields": [
    "financier", "quote_date", "customer_name", "vehicle_version",
    "vehicle_year", "vehicle_price", "down_payment", "amount_financed",
    "loan_term_months", "monthly_payment", "annual_rate", "cat_average",
    "first_receipt_amount", "offer_name"
  ],
  "optional_fields": [
    "down_payment_percent", "monthly_payment_from_month_13", "opening_fee",
    "free_insurance_months", "insurer", "insurance_total_amount",
    "insurance_term_months", "state", "municipality"
  ],
  "validators": {
    "vehicle_year": { "regex": "(19|20)\\d{2}", "description": "año de 4 dígitos" },
    "loan_term_months": { "regex": "\\d{1,3}", "description": "número entero de meses" }
  },
  "acceptance": {
    "min_expected_filled": 1.0,
    "min_accuracy": 0.9,
    "max_validation_failures": 0
  }
}
