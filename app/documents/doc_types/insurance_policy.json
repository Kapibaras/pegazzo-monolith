{
  "name": "insurance_policy",
  "label_es": "Póliza de seguro",
  "allowed_entity_types": ["car"],
  "has_expiry": true,
  "ai_analyzable": true,
  "fields": {
    "document_type": "type of document",
    "insurer": "insurance company name",
    "policy_number": "policy number (póliza)",
    "inciso": "inciso number",
    "endorsement": "endorsement number (endoso)",
    "insured_number": "insured number (No. de asegurado)",
    "package": "package (paquete), e.g. AMPLIA",
    "coverage_start": "start date of the policy validity",
    "coverage_end": "end date of the policy validity",
    "issue_date": "issue date (fecha de emisión)",
    "insured_name": "name of the insured (Asegurado)",
    "contractor": "owner / contractor line (Propietario/Contratante)",
    "rfc": "RFC of the insured",
    "street": "street and numbers of the address",
    "colony": "colony / neighborhood",
    "municipality": "municipality / delegation",
    "state": "state",
    "postal_code": "postal code (C.P.)",
    "phone": "phone number",
    "vehicle_description": "vehicle description",
    "brand": "make (marca)",
    "model_year": "model year (modelo)",
    "vin": "serial number / VIN (serie)",
    "engine_number": "engine number (motor)",
    "plates": "license plates (placas)",
    "capacity": "passenger capacity",
    "service": "service type, e.g. PARTICULAR",
    "use": "use (uso), e.g. PRIVADO",
    "vehicle_key": "vehicle key (clave vehicular)",
    "payment_form": "payment form (forma de pago)",
    "damage_sum_insured": "sum insured for DAÑOS MATERIALES",
    "damage_deductible": "deductible for DAÑOS MATERIALES",
    "theft_sum_insured": "sum insured for ROBO TOTAL",
    "theft_deductible": "deductible for ROBO TOTAL",
    "civil_liability_sum": "sum insured for RESPONSABILIDAD CIVIL",
    "net_premium": "prima neta",
    "policy_fee": "gastos de expedición",
    "iva": "I.V.A. amount",
    "total_premium": "prima total"
  },
  "expected_fields": [
    "document_type", "insurer", "policy_number", "coverage_start", "coverage_end",
    "issue_date", "insured_name", "rfc", "brand", "model_year", "vin",
    "engine_number", "total_premium"
  ],
  "optional_fields": [
    "inciso", "endorsement", "insured_number", "package", "contractor",
    "street", "colony", "municipality", "state", "postal_code", "phone",
    "vehicle_description", "plates", "capacity", "service", "use",
    "vehicle_key", "payment_form", "damage_sum_insured", "damage_deductible",
    "theft_sum_insured", "theft_deductible", "civil_liability_sum",
    "net_premium", "policy_fee", "iva"
  ],
  "validators": {
    "policy_number": { "regex": "[A-Z0-9]{8,14}", "description": "8 a 14 caracteres alfanuméricos" },
    "rfc": { "regex": "[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}", "description": "RFC de 12 o 13 caracteres" },
    "vin": { "regex": "[A-HJ-NPR-Z0-9]{17}", "description": "17 caracteres alfanuméricos, sin I, O ni Q" },
    "postal_code": { "regex": "\\d{5}", "description": "5 dígitos" },
    "model_year": { "regex": "(19|20)\\d{2}", "description": "año de 4 dígitos" }
  },
  "acceptance": {
    "min_expected_filled": 1.0,
    "min_accuracy": 0.9,
    "max_validation_failures": 0
  },
  "extra_instructions": "Extract data from the main policy cover sheet. Ignore the USA/Canada certificate and legal text."
}
