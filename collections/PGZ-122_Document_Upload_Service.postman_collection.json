{
  "info": {
    "name": "PGZ-122 Document Upload Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "csrf_access_token", "value": "" },
    { "key": "upload_url", "value": "" },
    { "key": "upload_key", "value": "" },
    { "key": "created_document_id", "value": "" },
    { "key": "car_id", "value": "FILL_WITH_EXISTING_CAR_ID" }
  ],
  "item": [
    {
      "name": "--- SETUP ---",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const csrf = pm.cookies.get('csrf_access_token');",
                  "if (csrf) pm.collectionVariables.set('csrf_access_token', csrf);",
                  "pm.test('Login exitoso', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"Ruben35\",\n    \"password\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/internal/auth/login",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "internal", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- PASO 1: Solicitar URL de carga ---",
      "item": [
        {
          "name": "POST upload-url (PDF → car)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Tiene upload_url y key', () => {",
                  "    pm.expect(data.upload_url).to.be.a('string');",
                  "    pm.expect(data.key).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('upload_url', data.upload_url);",
                  "pm.collectionVariables.set('upload_key', data.key);",
                  "console.log('upload_url:', data.upload_url);",
                  "console.log('key:', data.key);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filename\": \"contrato_arrendamiento.pdf\",\n    \"content_type\": \"application/pdf\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"{{car_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/upload-url",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "upload-url"]
            }
          },
          "response": []
        },
        {
          "name": "POST upload-url (imagen JPEG → car)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('upload_url', data.upload_url);",
                  "pm.collectionVariables.set('upload_key', data.key);",
                  "console.log('key:', data.key);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filename\": \"factura.jpg\",\n    \"content_type\": \"image/jpeg\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"{{car_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/upload-url",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "upload-url"]
            }
          },
          "response": []
        },
        {
          "name": "POST upload-url → 400 tipo no permitido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 - tipo no permitido', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => {",
                  "    pm.expect(pm.response.json().detail).to.include('not allowed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filename\": \"script.exe\",\n    \"content_type\": \"application/octet-stream\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"{{car_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/upload-url",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "upload-url"]
            }
          },
          "response": []
        },
        {
          "name": "POST upload-url → 404 entidad no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 - entidad no existe', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filename\": \"doc.pdf\",\n    \"content_type\": \"application/pdf\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"INEXISTENTE000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/upload-url",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "upload-url"]
            }
          },
          "response": []
        },
        {
          "name": "POST upload-url → 401 sin autenticación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 - sin auth', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filename\": \"doc.pdf\",\n    \"content_type\": \"application/pdf\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"{{car_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/upload-url",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "upload-url"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- PASO 2: Subir archivo directo a R2 ---",
      "item": [
        {
          "name": "PUT {{upload_url}} (archivo binario → R2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// La URL viene del paso anterior (upload_url).",
                  "// IMPORTANTE: en Body selecciona 'binary' y elige el archivo PDF/imagen del paso 1."
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Upload a R2 exitoso (200)', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/pdf",
                "description": "Cambia esto al content_type que usaste en el paso 1"
              }
            ],
            "body": {
              "mode": "file",
              "file": {}
            },
            "url": {
              "raw": "{{upload_url}}",
              "host": ["{{upload_url}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- PASO 3: Confirmar documento (crear registro) ---",
      "item": [
        {
          "name": "POST /documents (confirmar upload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Documento creado con id', () => pm.expect(data.id).to.be.a('number'));",
                  "pm.test('Category es pending', () => pm.expect(data.category).to.eql('pending'));",
                  "pm.test('URL es presigned GET URL', () => pm.expect(data.url).to.include('https'));",
                  "pm.collectionVariables.set('created_document_id', data.id);",
                  "console.log('document_id creado:', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"key\": \"{{upload_key}}\",\n    \"type\": \"contract\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"{{car_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents"]
            }
          },
          "response": []
        },
        {
          "name": "POST /documents → 404 entidad no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"key\": \"car/NOPE/uuid.pdf\",\n    \"type\": \"contract\",\n    \"entity_type\": \"car\",\n    \"entity_id\": \"NOPE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- GET documento ---",
      "item": [
        {
          "name": "GET /documents/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Tiene presigned GET URL', () => pm.expect(data.url).to.include('https'));",
                  "pm.test('ID correcto', () => pm.expect(data.id).to.eql(parseInt(pm.collectionVariables.get('created_document_id'))));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/{{created_document_id}}",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "{{created_document_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "GET /documents/:id → 404 no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/99999",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "99999"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "--- DELETE documento ---",
      "item": [
        {
          "name": "DELETE /documents/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje de éxito', () => pm.expect(pm.response.json().message).to.include('deleted'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/{{created_document_id}}",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "{{created_document_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /documents/:id → 404 no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/documents/99999",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "documents", "99999"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
