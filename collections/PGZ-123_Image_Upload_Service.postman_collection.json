{
  "info": {
    "name": "PGZ-123 Image Upload Service",
    "description": "Manual testing collection for the image upload service (presigned R2 public bucket flow).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/pegazzo" },
    { "key": "car_id",   "value": "CAR001" },
    { "key": "driver_id","value": "DRV001" },
    { "key": "upload_url",  "value": "" },
    { "key": "public_url",  "value": "" },
    { "key": "image_key",   "value": "" }
  ],
  "item": [
    {
      "name": "SETUP",
      "item": [
        {
          "name": "Login (get JWT cookies)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "const csrf = pm.cookies.get('csrf_access_token');",
                  "pm.collectionVariables.set('csrf_token', csrf);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\",\n  \"role\": \"owner\"\n}"
            },
            "url": "{{base_url}}/internal/auth/login"
          }
        }
      ]
    },
    {
      "name": "PASO 1 - Request Presigned PUT URL",
      "item": [
        {
          "name": "POST /upload-url (car_photo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Has upload_url', () => pm.expect(data.upload_url).to.be.a('string').and.not.empty);",
                  "pm.test('Has public_url', () => pm.expect(data.public_url).to.be.a('string').and.not.empty);",
                  "pm.test('Has key', () => pm.expect(data.key).to.include('car_photo/'));",
                  "pm.collectionVariables.set('upload_url', data.upload_url);",
                  "pm.collectionVariables.set('public_url', data.public_url);",
                  "pm.collectionVariables.set('image_key', data.key);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"photo.jpg\",\n  \"content_type\": \"image/jpeg\",\n  \"entity_type\": \"car_photo\",\n  \"entity_id\": \"{{car_id}}\"\n}"
            },
            "url": "{{base_url}}/management/images/upload-url"
          }
        },
        {
          "name": "POST /upload-url (car_agency_image)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"agency.png\",\n  \"content_type\": \"image/png\",\n  \"entity_type\": \"car_agency_image\",\n  \"entity_id\": \"{{car_id}}\"\n}"
            },
            "url": "{{base_url}}/management/images/upload-url"
          }
        },
        {
          "name": "POST /upload-url (driver_photo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"driver.webp\",\n  \"content_type\": \"image/webp\",\n  \"entity_type\": \"driver_photo\",\n  \"entity_id\": \"{{driver_id}}\"\n}"
            },
            "url": "{{base_url}}/management/images/upload-url"
          }
        },
        {
          "name": "POST /upload-url - INVALID content_type (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 for gif', () => pm.response.to.have.status(400));",
                  "pm.test('Detail mentions not allowed', () => pm.expect(pm.response.json().detail).to.include('not allowed'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"anim.gif\",\n  \"content_type\": \"image/gif\",\n  \"entity_type\": \"car_photo\",\n  \"entity_id\": \"{{car_id}}\"\n}"
            },
            "url": "{{base_url}}/management/images/upload-url"
          }
        },
        {
          "name": "POST /upload-url - Car not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 for unknown car', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"photo.jpg\",\n  \"content_type\": \"image/jpeg\",\n  \"entity_type\": \"car_photo\",\n  \"entity_id\": \"NONEXISTENT\"\n}"
            },
            "url": "{{base_url}}/management/images/upload-url"
          }
        }
      ]
    },
    {
      "name": "PASO 2 - PUT image to R2 (binary upload)",
      "item": [
        {
          "name": "PUT to R2 presigned URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('R2 upload OK (200)', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "image/jpeg" }
            ],
            "body": {
              "mode": "file",
              "file": { "src": "" }
            },
            "url": "{{upload_url}}",
            "description": "Select any JPEG file from disk as the binary body. The URL is the presigned PUT URL returned in PASO 1."
          }
        }
      ]
    },
    {
      "name": "PASO 3 - Record URL in entity",
      "item": [
        {
          "name": "POST /cars/:car_id/photos (add photo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Message present', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{public_url}}\"\n}"
            },
            "url": "{{base_url}}/management/images/cars/{{car_id}}/photos"
          }
        },
        {
          "name": "PATCH /cars/:car_id/agency-image",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{public_url}}\"\n}"
            },
            "url": "{{base_url}}/management/images/cars/{{car_id}}/agency-image"
          }
        },
        {
          "name": "PATCH /drivers/:driver_id/photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{public_url}}\"\n}"
            },
            "url": "{{base_url}}/management/images/drivers/{{driver_id}}/photo"
          }
        }
      ]
    },
    {
      "name": "PASO 4 - Remove car photo",
      "item": [
        {
          "name": "DELETE /cars/:car_id/photos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{public_url}}\"\n}"
            },
            "url": "{{base_url}}/management/images/cars/{{car_id}}/photos"
          }
        },
        {
          "name": "DELETE /cars/:car_id/photos - Photo not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 when photo not in list', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://pub.example.com/nonexistent.jpg\"\n}"
            },
            "url": "{{base_url}}/management/images/cars/{{car_id}}/photos"
          }
        }
      ]
    }
  ]
}
