              "raw": "{{base_url}}/pegazzo/management/cars?page=1&limit=2",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "cars"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "2" }
              ]
            }
