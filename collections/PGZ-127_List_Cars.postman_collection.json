    {
      "name": "PASO 1 – List all (default)",
      "item": [
        {
          "name": "List cars – default (no filters)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-CSRF-TOKEN", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/cars",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "cars"]
            }
          },
          "response": []
