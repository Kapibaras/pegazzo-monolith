# Development
ENVIRONMENT=
DEBUG=

# Auth
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MIN=
JWT_REFRESH_TOKEN_EXPIRES_DAYS=

# Database
DATABASE_URL=

# CORS (comma-separated list of allowed origins, required for STAGING and PRODUCTION)
# Example: CORS_ORIGINS=https://app.pegazzo.com,https://admin.pegazzo.com
CORS_ORIGINS=

# API Docs (required for STAGING, ignored in LOCAL and PRODUCTION)
DOCS_USER=
DOCS_PASSWORD=

# Celery (task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
WORKER_STUCK_TASK_MINUTES=10

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DOCUMENTS_BUCKET=
R2_IMAGES_BUCKET=
R2_PUBLIC_URL=

# AI provider (Gemini) — API service only, never on the Celery worker/beat
# Google AI Studio API key (secret, required outside LOCAL)
GOOGLE_API_KEY=
# Gemini model used for document extraction
GEMINI_MODEL=gemini-3.6-flash
# Timeout in seconds for a single provider call
GEMINI_TIMEOUT_SECONDS=15
# Max document size accepted for AI analysis, in bytes (provisional, final value in PGZ-187)
AI_MAX_DOCUMENT_BYTES=10485760
# Total retry budget in seconds within one request (must be >= GEMINI_TIMEOUT_SECONDS)
AI_RETRY_BUDGET_SECONDS=20
