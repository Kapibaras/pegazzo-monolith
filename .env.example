# Development
ENVIRONMENT=
DEBUG=

# Auth
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MIN=
JWT_REFRESH_TOKEN_EXPIRES_DAYS=

# Database
DATABASE_URL=

# CORS (comma-separated list of allowed origins, required for STAGING and PRODUCTION)
# Example: CORS_ORIGINS=https://app.pegazzo.com,https://admin.pegazzo.com
CORS_ORIGINS=

# API Docs (required for STAGING, ignored in LOCAL and PRODUCTION)
DOCS_USER=
DOCS_PASSWORD=

# Celery (task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
WORKER_STUCK_TASK_MINUTES=10

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DOCUMENTS_BUCKET=
R2_IMAGES_BUCKET=
R2_PUBLIC_URL=