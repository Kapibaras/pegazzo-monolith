{
  "info": {
    "name": "PGZ-126 - Create Car",
    "description": "Manual tests for POST /pegazzo/management/cars endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "csrf_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_insurance_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "--- SETUP ---",
      "item": [
        {
          "name": "0. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const cookies = pm.cookies.toObject();",
                  "const csrfToken = cookies['csrf_access_token'];",
                  "if (csrfToken) {",
                  "    pm.collectionVariables.set('csrf_access_token', csrfToken);",
                  "}",
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_USERNAME\",\n  \"password\": \"YOUR_PASSWORD\",\n  \"role\": \"owner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/internal/auth/login",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "internal", "auth", "login"]
            }
          }
        },
        {
          "name": "0b. Create insurance provider (prerequisite)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Insurance created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('created_insurance_id', data.id);",
                  "    console.log('Insurance id saved:', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AXA Seguros\",\n  \"telephones\": [\"55-1234-5678\", \"800-123-4567\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/insurances",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "insurances"]
            }
          }
        }
      ]
    },
    {
      "name": "--- POST ---",
      "item": [
        {
          "name": "1. SUCCESS - Create car (full payload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains car id', function () {",
                  "    pm.expect(pm.response.json().id).to.eql('CAR-001');",
                  "});",
                  "pm.test('Response contains make, model, vin, plate', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.make).to.eql('Toyota');",
                  "    pm.expect(data.model).to.eql('Corolla');",
                  "    pm.expect(data.vin).to.eql('1HGBH41JXMN109186');",
                  "    pm.expect(data.plate).to.eql('ABC-1234');",
                  "});",
                  "pm.test('createdAt and updatedAt present', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.createdAt).to.exist;",
                  "    pm.expect(data.updatedAt).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
