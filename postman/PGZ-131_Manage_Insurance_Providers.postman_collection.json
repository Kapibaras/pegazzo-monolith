                  "pm.test('Returns array with items', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "    console.log('Total providers:', data.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/insurances",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "insurances"]
            }
          }
        },
        {
          "name": "7. SUCCESS - Search by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns only matching results', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    data.forEach(item => {",
                  "        pm.expect(item.name.toLowerCase()).to.include('axa');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/insurances?search=AXA",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "insurances"],
              "query": [{ "key": "search", "value": "AXA" }]
            }
          }
        },
