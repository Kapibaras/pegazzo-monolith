{
  "info": {
    "name": "PGZ-131 - Manage Insurance Providers",
    "description": "Manual tests for /pegazzo/management/insurances CRUD endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "csrf_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_insurance_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Login (run first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const cookies = pm.cookies.toObject();",
              "const csrfToken = cookies['csrf_access_token'];",
              "if (csrfToken) {",
              "    pm.collectionVariables.set('csrf_access_token', csrfToken);",
              "    console.log('CSRF token saved:', csrfToken);",
              "} else {",
              "    console.warn('No csrf_access_token found. Check credentials.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"YOUR_USERNAME\",\n  \"password\": \"YOUR_PASSWORD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/pegazzo/internal/auth/login",
          "host": ["{{base_url}}"],
          "path": ["pegazzo", "internal", "auth", "login"]
        }
      }
    },
    {
      "name": "--- POST ---",
      "item": [
        {
          "name": "1. SUCCESS - Create insurance (with telephones)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has id, name and telephones', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.id).to.exist;",
                  "    pm.expect(data.name).to.eql('AXA Seguros');",
                  "    pm.expect(data.telephones).to.include('+521234567890');",
                  "    pm.collectionVariables.set('created_insurance_id', data.id);",
                  "    console.log('Saved insurance id:', data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AXA Seguros\",\n  \"telephones\": [\"+521234567890\", \"+529876543210\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/insurances",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "insurances"]
            }
          }
        },
        {
          "name": "2. SUCCESS - Create insurance (without telephones)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Telephones is empty or null', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.name).to.eql('GNP Seguros');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
