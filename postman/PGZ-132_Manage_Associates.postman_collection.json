    {
      "name": "--- GET ---",
      "item": [
        {
          "name": "6. SUCCESS - List all associates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns a list', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/associates",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "associates"]
            }
          }
        },
        {
          "name": "7. SUCCESS - Search by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Results match search term', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "    data.forEach(a => {",
                  "        const matches = a.name.toLowerCase().includes('carlos') || a.surnames.toLowerCase().includes('carlos');",
                  "        pm.expect(matches).to.be.true;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/associates?search=Carlos",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "associates"],
              "query": [{ "key": "search", "value": "Carlos" }]
            }
          }
        },
        {
          "name": "8. SUCCESS - Search with no match",
          "event": [
            {
              "listen": "test",
              "script": {
