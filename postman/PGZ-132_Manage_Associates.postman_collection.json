                  "});",
                  "pm.test('Returns empty list', function () {",
                  "    pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/pegazzo/management/associates?search=Nonexistent99999",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "associates"],
              "query": [{ "key": "search", "value": "Nonexistent99999" }]
            }
          }
