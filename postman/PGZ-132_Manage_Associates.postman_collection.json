{
  "info": {
    "name": "PGZ-132 - Manage Associates",
    "description": "Manual tests for CRUD /pegazzo/management/associates endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "csrf_access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_associate_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "--- SETUP ---",
      "item": [
        {
          "name": "0. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const cookies = pm.cookies.toObject();",
                  "const csrfToken = cookies['csrf_access_token'];",
                  "if (csrfToken) {",
                  "    pm.collectionVariables.set('csrf_access_token', csrfToken);",
                  "}",
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_USERNAME\",\n  \"password\": \"YOUR_PASSWORD\",\n  \"role\": \"owner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/internal/auth/login",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "internal", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "--- POST ---",
      "item": [
        {
          "name": "1. SUCCESS - Create associate (with telephones)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains associate data', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.name).to.eql('Carlos');",
                  "    pm.expect(data.surnames).to.eql('Gomez Ruiz');",
                  "    pm.expect(data.telephones).to.include('55-1234-5678');",
                  "    pm.expect(data.id).to.exist;",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.id) {",
                  "    pm.collectionVariables.set('created_associate_id', data.id);",
                  "    console.log('Associate id saved:', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos\",\n  \"surnames\": \"Gomez Ruiz\",\n  \"telephones\": [\"55-1234-5678\", \"800-987-6543\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/associates",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "associates"]
            }
          }
        },
        {
          "name": "2. SUCCESS - Create associate (without telephones)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Associate created without telephones', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.name).to.eql('Sofia');",
                  "    pm.expect(data.surnames).to.eql('Lopez Torres');",
                  "    pm.expect(data.id).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-ACCESS", "value": "{{csrf_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sofia\",\n  \"surnames\": \"Lopez Torres\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pegazzo/management/associates",
              "host": ["{{base_url}}"],
              "path": ["pegazzo", "management", "associates"]
            }
          }
        },
